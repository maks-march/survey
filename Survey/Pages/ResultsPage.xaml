<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Survey.Pages.ResultsPage"
             BackgroundColor="{ StaticResource MainBackground }"
             Shell.NavBarIsVisible="False">
    <ScrollView Orientation="Vertical">
        <VerticalStackLayout>
            <HorizontalStackLayout Style="{StaticResource Header}">
                <Image Source="cat_icon.png" Style="{StaticResource Icon}"/>
                <Label Text="Мелки лапки" Style="{StaticResource Heading}" />
            </HorizontalStackLayout>

            <VerticalStackLayout>
                <Label Text="Ваш котик" Style="{StaticResource Title}"/>
                <Label x:Name="SummaryLabel" Style="{StaticResource SubTitle}" Margin="0,10" />
            </VerticalStackLayout>

            <Border Style="{StaticResource EntryFrame}">
                <VerticalStackLayout x:Name="RowsStack" Spacing="14" />
            </Border>

            <Grid Style="{StaticResource Footer}">
                <Button Style="{StaticResource PrimaryButton}"
                        Text="Начать сначала"
                        Clicked="GoToMain" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
