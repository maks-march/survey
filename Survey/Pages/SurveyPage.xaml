<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Survey.Pages.SurveyPage"
             BackgroundColor="{ StaticResource MainBackground }"
             Shell.NavBarIsVisible="False">
    <ScrollView Orientation="Vertical">
        <VerticalStackLayout>
            <HorizontalStackLayout Style="{StaticResource Header }">
                <Image Source="cat_icon.png" Style="{ StaticResource Icon}"/>
                <Label Text="Мелки лапки" Style="{ StaticResource Heading }" />
            </HorizontalStackLayout>
            <VerticalStackLayout>
                <Label Text="Кто с тобой живет?" Style="{ StaticResource Title}"/>
                <Label Text="Давайте начнем с вашей связи с кошками." 
                    Style="{ StaticResource SubTitle}" Margin="0,10" />
            </VerticalStackLayout>
            <!--#region RadioButton -->
            <VerticalStackLayout Spacing="10">
                <Label Text="Есть ли у вас кот?" Style="{StaticResource Queston}"/>
                <Border Style="{StaticResource Frame}"
                        x:Name="YesBorder">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTappedCatOption" />
                    </Border.GestureRecognizers>

                    <FlexLayout 
                        Direction="Row" 
                        AlignItems="Center" Style="{StaticResource BlockRow}">
                        <Image Source="cat_icon.png" Style="{StaticResource Icon}"/>
                        <Label Text="Да у меня есть кот." 
                               Style="{StaticResource Queston}"
                               FlexLayout.Grow="1" />
                        <RadioButton
                             x:Name="YesOption"
                             GroupName="catOptions"
                             InputTransparent="True"
                             CheckedChanged="OnCatOptionChanged" />
                    </FlexLayout>
                </Border>
                <Border Style="{StaticResource Frame}"
                        x:Name="PlaningBorder">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTappedCatOption" />
                    </Border.GestureRecognizers>

                    <FlexLayout 
                        Direction="Row" 
                        AlignItems="Center" Style="{StaticResource BlockRow}">
                        <Image Source="house.png" Style="{StaticResource Icon}"/>
                        <Label Text="Планирую завести котика!" 
                               Style="{StaticResource Queston}"
                               FlexLayout.Grow="1" />
                        <RadioButton
                             x:Name="PlaningOption"
                             GroupName="catOptions"
                             InputTransparent="True"
                             CheckedChanged="OnCatOptionChanged" 
                            />
                    </FlexLayout>
                </Border>
                <Border Style="{StaticResource Frame}"
                        x:Name="LoveBorder">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTappedCatOption" />
                    </Border.GestureRecognizers>
                    <FlexLayout 
                        Direction="Row" 
                        AlignItems="Center" Style="{StaticResource BlockRow}">
                        <Image Source="heart.png" Style="{StaticResource Icon}"/>
                        <Label Text="Просто люблю котов!" 
                               Style="{StaticResource Queston}"
                               FlexLayout.Grow="1" />
                        <RadioButton
                             x:Name="LoveOption"
                             GroupName="catOptions"
                             InputTransparent="True"
                             CheckedChanged="OnCatOptionChanged" />
                    </FlexLayout>
                </Border>
            </VerticalStackLayout>
            <!--#endregion RadioButton -->

            <!--#region Stepper -->
            <VerticalStackLayout>
                <Label x:Name="HintLabel" 
                       Style="{StaticResource Queston}" 
                       Text="Сначала выбери вариант выше!"/>
                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="25">
                    <Label x:Name="Count" 
                           Text="{Binding Source={x:Reference CatStepper}, Path=Value}"
                           Style="{StaticResource Title}"/>
                    <Stepper x:Name="CatStepper"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"
                             Value="0"
                             ValueChanged="OnStepperValueChanged"
                             HorizontalOptions="Center" />
                </HorizontalStackLayout>
                <Label Style="{StaticResource SubTitle}" 
                       FontSize="12" 
                       Text="Если котиков много, дальше расскажите о самом любимом!"/>

            </VerticalStackLayout>
            <!--#endregion Stepper -->

            <!--#region Entries -->

            <VerticalStackLayout>
                <Label Text="Познакомимся с любимчиком :3" Style="{ StaticResource Title}"/>
                <Label Text="Кто же он такой?" 
                    Style="{ StaticResource SubTitle}" Margin="0,10" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label Text="Итак, его имя" Style="{StaticResource Queston}"/>
                <Border Style="{StaticResource EntryFrame}">
                    <Entry Placeholder="Шлёпа?"
                           TextChanged="OnCatNameChanged"
                           x:Name="NameEntry"/>
                </Border>
                <Label Text="И порода" Style="{StaticResource Queston}"/>

                <Border Style="{StaticResource EntryFrame}">
                    <Picker x:Name="CatPicker"
                        Title="Дворовый"
                        SelectedIndexChanged="OnBreedChanged">
                        <Picker.Items>
                            <x:String>Персидский</x:String>
                            <x:String>Британский</x:String>
                            <x:String>Мейн-кун</x:String>
                            <x:String>Сфинкс</x:String>
                        </Picker.Items>
                    </Picker>
                </Border>

                <Label Text="{Binding Source={x:Reference NameEntry}, Path=Text, StringFormat='Сколько весит {0}?'}" 
                       Style="{StaticResource Queston}"/>
                <Border Style="{StaticResource EntryFrame}">
                    <Entry Placeholder="6-7?"
                           TextChanged="OnCatAgeChanged"
                           Keyboard="Numeric"/>
                </Border>

                <Label Text="{Binding Source={x:Reference NameEntry}, Path=Text, StringFormat='Когда {0} появился у вас?'}" Style="{StaticResource Queston}"/>
                <Border Style="{StaticResource EntryFrame}">
                    <DatePicker x:Name="ReceivedDatePicker"
                                Format="dd MMMM yyyy"
                                DateSelected="OnReceivedDateSelected" />
                </Border>

            </VerticalStackLayout>

            <!--#endregion Entries -->

            <!--#region Checkbox -->
            
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding Source={x:Reference NameEntry}, Path=Text, StringFormat='Обычно {0}...'}" 
                       Style="{ StaticResource Queston}"/>
                <Border x:Name="PlayfulBorder"
                        Style="{StaticResource EntryFrame}"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer 
                                Tapped="OnTappedChecked"
                                CommandParameter="{x:Reference PlayfulBox}" />
                    </Border.GestureRecognizers>
                    <FlexLayout Direction="Row" 
                                AlignItems="Center"
                                Style="{StaticResource BlockRow}">
                        <Image Source="house.png" Style="{StaticResource Icon}"/>
                        <Label Text="Игривый исследователь"
                               Style="{StaticResource Queston}"
                               FlexLayout.Grow="1" />
                        <CheckBox x:Name="PlayfulBox" 
                                  Color="#B8573C" 
                                  InputTransparent="True"
                                  CheckedChanged="OnCheckedChanged" />
                    </FlexLayout>
                </Border>
                <Border x:Name="CuteBorder"
                        Style="{StaticResource EntryFrame}"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer 
                                Tapped="OnTappedChecked"
                                CommandParameter="{x:Reference CuteBox}" />
                    </Border.GestureRecognizers>
                    <FlexLayout Direction="Row" 
                                AlignItems="Center"
                                Style="{StaticResource BlockRow}">
                        <Image Source="heart.png" Style="{StaticResource Icon}"/>
                        <Label Text="Милый спутник"
                               Style="{StaticResource Queston}"
                               FlexLayout.Grow="1" />
                        <CheckBox x:Name="CuteBox" 
                                  Color="#B8573C" 
                                  InputTransparent="True"
                                  CheckedChanged="OnCheckedChanged" />
                    </FlexLayout>
                </Border>
                <Border x:Name="FreeBorder"
                        Style="{StaticResource EntryFrame}"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer 
                                Tapped="OnTappedChecked"
                                CommandParameter="{x:Reference FreeBox}" />
                    </Border.GestureRecognizers>
                    <FlexLayout Direction="Row" 
                                AlignItems="Center"
                                Style="{StaticResource BlockRow}">
                        <Image Source="sparks.png" Style="{StaticResource Icon}"/>
                        <Label Text="Несгибаемый дух"
                               Style="{StaticResource Queston}"
                               FlexLayout.Grow="1" />
                        <CheckBox x:Name="FreeBox" 
                                  Color="#B8573C" 
                                  InputTransparent="True"
                                  CheckedChanged="OnCheckedChanged" />
                    </FlexLayout>
                </Border>
                <Border x:Name="ShyBorder"
                        Style="{StaticResource EntryFrame}"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer 
                                Tapped="OnTappedChecked"
                                CommandParameter="{x:Reference ShyBox}" />
                    </Border.GestureRecognizers>
                    <FlexLayout Direction="Row" 
                                AlignItems="Center"
                                Style="{StaticResource BlockRow}">
                        <Image Source="house.png" Style="{StaticResource Icon}"/>
                        <Label Text="Робкая душа"
                               Style="{StaticResource Queston}"
                               FlexLayout.Grow="1" />
                        <CheckBox x:Name="ShyBox" 
                                  Color="#B8573C" 
                                  InputTransparent="True"
                                  CheckedChanged="OnCheckedChanged" />
                    </FlexLayout>
                </Border>
            </VerticalStackLayout>
            
            <!--#endregion Checkbox -->

            <!--#region Switch -->
            <VerticalStackLayout>
                <Label Text="Здоровье" 
                   Style="{StaticResource Queston}"
                   Margin="0,0,0,10"/>
                <Border Style="{StaticResource EntryFrame}">
                    <Grid 
                    ColumnDefinitions="4*,1*"
                    Padding="15">
                        <Label Text="{Binding Source={x:Reference NameEntry}, Path=Text, StringFormat='{0} посещает ветеринара для плановых осмотров.'}"
                            Style="{StaticResource SubTitle}" 
                            Grid.Column="0"/>
                        <Switch x:Name="VetSwitch"
                            OnColor="#B8573C"
                            ThumbColor="White"
                            Toggled="OnVetToggled" 
                            Grid.Column="1"
                            Scale="1.5"/>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!--#endregion Switch -->

            <!--#region Entry-->

            <VerticalStackLayout Spacing="10">
                <Label Text="Что ещё хотите рассказать?" Style="{StaticResource Queston}"/>
                <Border Style="{StaticResource EntryFrame}" 
                    Padding="16,12">
                    <Editor x:Name="NotesEditor"
                        Placeholder="Любимая игрушка, привычки, что-то смешное..."
                        PlaceholderColor="#8A8178"
                        TextColor="#2B2B2B"
                        FontFamily="InterRegular"
                        BackgroundColor="Transparent"
                        HeightRequest="120"
                        AutoSize="TextChanges"
                        TextChanged="OnNotesChanged" />
                </Border>
            </VerticalStackLayout>
            
            <!--#endregion Entry-->
            
            <Grid
                Style="{StaticResource Footer }"
                ColumnDefinitions="2.5*,3*"
                ColumnSpacing="10">
                <Button Style="{ StaticResource SecondaryButton }" 
                    Text="Заново"
                    Clicked="GoToMain"
                    Grid.Column="0"></Button>
                <Button Style="{ StaticResource PrimaryButton }" 
                    Text="Результаты"
                    Clicked="GoToResults"
                    Grid.Column="1"></Button>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>