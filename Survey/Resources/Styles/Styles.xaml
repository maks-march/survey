<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!--#region Elements -->

    <Style x:Key="Heading" TargetType="Label">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value= "{ StaticResource DarkText }" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <Style x:Key="Title" TargetType="Label">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="TextColor" Value= "{ StaticResource DarkText }" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="SubTitle" 
           TargetType="Label" 
           BasedOn="{StaticResource Title}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="TextColor" Value= "{ StaticResource LightText }" />
    </Style>
    
    <Style x:Key="Queston" 
           TargetType="Label"
           BasedOn="{StaticResource Title}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value= "{ StaticResource DarkText }" />
    </Style>
    
    <!--#endregion Elements -->

    <!--#region Blocks -->


    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value= "{ StaticResource Button }" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="35" />
        <Setter Property="Padding" Value="35,10,35,10"/>
    </Style>
    
    <Style x:Key="SecondaryButton" 
           TargetType="Button" 
           BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BackgroundColor" Value= "{ StaticResource MainBackground }" />
        <Setter Property="BorderColor" Value= "{ StaticResource DarkText }" />
        <Setter Property="BorderWidth" Value= "2" />
        <Setter Property="TextColor" Value="{ StaticResource DarkText }" />
    </Style>

    <Style x:Key="Icon" TargetType="Image">
        <Setter Property="WidthRequest" Value="32" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="Margin" Value="10, 0, 10, 0" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Aspect" Value="Center" />
    </Style>

    <Style x:Key="BlockRow" 
           TargetType="Layout"
           ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="10, 20, 10, 20" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>
    
    <Style x:Key="Header" 
           TargetType="Layout" 
           ApplyToDerivedTypes="True"
           BasedOn="{ StaticResource BlockRow}">
        <Setter Property="VerticalOptions" Value="Start"/>
    </Style>

    <Style x:Key="Footer" 
           TargetType="Layout" 
           ApplyToDerivedTypes="True"
           BasedOn="{ StaticResource BlockRow}">
        <Setter Property="VerticalOptions" Value="End"/>
    </Style>

    <Style TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="10, 20, 10, 20" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
    </Style>

    <Style x:Key="Frame" TargetType="Border">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 35" />
        <Setter Property="Stroke" Value="{StaticResource SecondaryButton}" />
        
    </Style>
    
    <Style x:Key="PhotoBorder" TargetType="Border">
        <Setter Property="WidthRequest" Value="364" />
        <Setter Property="HeightRequest" Value="292" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="32" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Unchecked" />
                    <VisualState x:Name="Checked">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource Button}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!--#endregion Blocks -->

</ResourceDictionary>
