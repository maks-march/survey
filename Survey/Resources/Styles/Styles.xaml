<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!--#region Elements -->

    <Style x:Key="Heading" TargetType="Label">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value= "{ StaticResource DarkText }" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <Style x:Key="Title" TargetType="Label">
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="TextColor" Value= "{ StaticResource DarkText }" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <Style x:Key="SubTitle" TargetType="Label">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="TextColor" Value= "{ StaticResource LightText }" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>
    
    <!--#endregion Elements -->

    <!--#region Blocks -->


    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value= "{ StaticResource Button }" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalOptions" Value="Fill"/>
        <Setter Property="VerticalOptions" Value="Fill"/>
        <Setter Property="Padding" Value="10,10,10,10"/>
        
    </Style>

    <Style x:Key="Icon" TargetType="Image">
        <Setter Property="WidthRequest" Value="32" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="Margin" Value="10, 0, 10, 0" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="BlockRow" 
           TargetType="HorizontalStackLayout">
        <Setter Property="Padding" Value="10, 20, 10, 20" />
        <Setter Property="HorizontalOptions" Value="Fill"/>
    </Style>
    
    <Style x:Key="Header" 
           TargetType="HorizontalStackLayout" 
           BasedOn="{ StaticResource BlockRow}">
        <Setter Property="VerticalOptions" Value="Start"/>
    </Style>

    <Style x:Key="Footer" 
           TargetType="HorizontalStackLayout" 
           BasedOn="{ StaticResource BlockRow}">
        <Setter Property="VerticalOptions" Value="End"/>
    </Style>

    <Style TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="10, 20, 10, 20" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
    </Style>
    
    <Style x:Key="PhotoBorder" TargetType="Border">
        <Setter Property="WidthRequest" Value="364" />
        <Setter Property="HeightRequest" Value="292" />
    </Style>

    <!--#endregion Blocks -->

</ResourceDictionary>
